#!/bin/bash
set -e  # Berhenti jika ada error

# Ambil antarmuka jaringan utama
interface=$(ip -4 route ls | grep default | grep -Po '(?<=dev )(\S+)' | head -1)
if [ -z "$interface" ]; then
    echo "ERROR: Tidak dapat menemukan antarmuka jaringan!"
    exit 1
fi
echo "Menggunakan antarmuka: $interface"

# Cadangkan aturan lama
cp /etc/iptables/rules.v4 /etc/iptables/rules.v4.bak.$(date +%Y%m%d_%H%M%S)

cat >/etc/iptables/rules.v4 <<EOF
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

# Izinkan loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# Izinkan koneksi yang sudah terhubung/terkait
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# === Port Umum ===
-A INPUT -p tcp --dport 80 -j ACCEPT
-A INPUT -p tcp --dport 443 -j ACCEPT
-A INPUT -p tcp --dport 53 -j ACCEPT
-A INPUT -p udp --dport 53 -j ACCEPT

# === Port HAProxy ===
-A INPUT -p tcp --dport 55 -j ACCEPT
-A INPUT -p tcp --dport 8080 -j ACCEPT
-A INPUT -p tcp --dport 8880 -j ACCEPT
-A INPUT -p tcp --dport 2082 -j ACCEPT
-A INPUT -p tcp --dport 2086 -j ACCEPT
-A INPUT -p tcp --dport 2095 -j ACCEPT
-A INPUT -p tcp --dport 2222 -j ACCEPT
-A INPUT -p tcp --dport 2223 -j ACCEPT
-A INPUT -p tcp --dport 1010 -j ACCEPT
-A INPUT -p tcp --dport 1012 -j ACCEPT
-A INPUT -p tcp --dport 1013 -j ACCEPT
-A INPUT -p tcp --dport 1194 -j ACCEPT

# Rentang port 222-1000
-A INPUT -p tcp --dport 222:1000 -j ACCEPT

# Rentang port 10000-10015
-A INPUT -p tcp --dport 10000:10015 -j ACCEPT

# Port tambahan
-A INPUT -p tcp --dport 3128 -j ACCEPT
-A INPUT -p udp --dport 2100 -j ACCEPT
-A INPUT -p udp --dport 2200 -j ACCEPT
-A INPUT -p udp --dport 5300 -j ACCEPT
-A INPUT -p udp --dport 7100 -j ACCEPT
-A INPUT -p udp --dport 7200 -j ACCEPT
-A INPUT -p udp --dport 7300 -j ACCEPT

# === TOLAK BitTorrent (jika ingin blokir) ===
# Hapus tanda # di bawah jika ingin menolak
# -A FORWARD -m string --algo bm --string "BitTorrent" -j DROP
# -A FORWARD -m string --algo bm --string "info_hash" -j DROP
# -A FORWARD -m string --algo bm --string ".torrent" -j DROP

# Izinkan lainnya
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -s 10.8.0.0/24 -j ACCEPT
-A FORWARD -s 20.8.0.0/24 -j ACCEPT

COMMIT

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

-A PREROUTING -i $interface -p udp --dport 53 -j REDIRECT --to-port 5300
-A POSTROUTING -s 10.8.0.0/24 -o $interface -j MASQUERADE
-A POSTROUTING -s 20.8.0.0/24 -o $interface -j MASQUERADE

COMMIT
EOF

# IPv6
cat >/etc/iptables/rules.v6 <<'EOF'
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p tcp --dport 80 -j ACCEPT
-A INPUT -p tcp --dport 443 -j ACCEPT
-A INPUT -p udp --dport 53 -j ACCEPT
COMMIT
EOF

# Terapkan aturan
echo "Memuat aturan iptables..."
netfilter-persistent reload
systemctl restart netfilter-persistent

echo "Selesai! Aturan lama dibackup ke /etc/iptables/rules.v4.bak.*"
