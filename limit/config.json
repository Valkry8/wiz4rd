{
  "log": {
    "loglevel": "warning",
    "error": "/var/log/xray/error.log",
    "access": "/var/log/xray/access.log"
  },
  "api": {
    "services": ["HandlerService", "LoggerService", "StatsService"],
    "tag": "api"
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "handshake": 2,
        "connIdle": 128,
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10000,
      "protocol": "dokodemo-door",
      "settings": {"address": "127.0.0.1"},
      "tag": "api"
    },
    {
      "listen": "127.0.0.1",
      "port": 10001,
      "protocol": "vless",
      "settings": {
        "decryption": "none",
        "clients": [{"id": "151b8ae3-6dbe-4944-8d7d-ff1d6132bf8e"}]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {"path": "/vless"}
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 10002,
      "protocol": "vmess",
      "settings": {
        "clients": [{"id": "151b8ae3-6dbe-4944-8d7d-ff1d6132bf8e", "alterId": 0}]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {"path": "/vmess"}
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 10003,
      "protocol": "trojan",
      "settings": {
        "decryption": "none",
        "clients": [{"password": "151b8ae3-6dbe-4944-8d7d-ff1d6132bf8e"}]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {"path": "/trojan-ws"},
        "udp": true
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 10004,
      "protocol": "shadowsocks",
      "settings": {
        "method": "aes-128-gcm",
        "password": "151b8ae3-6dbe-4944-8d7d-ff1d6132bf8e",
        "network": "tcp,udp"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {"path": "/ss-ws"}
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 10005,
      "protocol": "vless",
      "settings": {
        "decryption": "none",
        "clients": [{"id": "151b8ae3-6dbe-4944-8d7d-ff1d6132bf8e"}]
      },
      "streamSettings": {
        "network": "grpc",
        "grpcSettings": {"serviceName": "vless-grpc"}
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 10006,
      "protocol": "vmess",
      "settings": {
        "clients": [{"id": "151b8ae3-6dbe-4944-8d7d-ff1d6132bf8e", "alterId": 0}]
      },
      "streamSettings": {
        "network": "grpc",
        "grpcSettings": {"serviceName": "vmess-grpc"}
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 10007,
      "protocol": "trojan",
      "settings": {
        "decryption": "none",
        "clients": [{"password": "151b8ae3-6dbe-4944-8d7d-ff1d6132bf8e"}]
      },
      "streamSettings": {
        "network": "grpc",
        "grpcSettings": {"serviceName": "trojan-grpc"}
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 10008,
      "protocol": "shadowsocks",
      "settings": {
        "method": "aes-128-gcm",
        "password": "151b8ae3-6dbe-4944-8d7d-ff1d6132bf8e",
        "network": "tcp,udp"
      },
      "streamSettings": {
        "network": "grpc",
        "grpcSettings": {"serviceName": "ss-grpc"}
      }
    }
  ],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct", "settings": {}},
    {"protocol": "freedom", "tag": "proxy", "settings": {}},
    {"protocol": "blackhole", "tag": "blocked", "settings": {}},
    {"protocol": "blackhole", "tag": "block", "settings": {}},
    {"protocol": "dns", "tag": "dnsOut", "settings": {}},
    {"protocol": "blackhole", "tag": "reject", "settings": {}}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {"inboundTag": ["api"], "outboundTag": "api", "type": "field"},
      {"protocol": ["bittorrent"], "outboundTag": "blocked", "type": "field"},
      {"ip": ["1.1.1.1/32", "8.8.8.8/32"], "outboundTag": "proxy", "type": "field"},
      {"ip": ["223.5.5.5/32", "114.114.114.114/32"], "outboundTag": "direct", "type": "field"},
      {"domain": ["geosite:category-ads-all"], "outboundTag": "reject", "type": "field"}
    ]
  },
  "dns": {
    "hosts": {
      "dns.google": "8.8.8.8",
      "dns.pub": "119.29.29.29",
      "dns.alidns.com": "223.5.5.5",
      "geosite:category-ads-all": "127.0.0.1"
    },
    "servers": [
      {"address": "https://1.1.1.1/dns-query", "domains": ["geosite:geolocation-!cn"]},
      "8.8.8.8",
      {"address": "114.114.114.114", "port": 53, "domains": ["geosite:cn"], "skipFallback": true}
    ]
  }
}

